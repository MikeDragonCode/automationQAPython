# Скопируйте в .env.local для локального запуска (.env.local уже в .gitignore)
# и продублируйте оба значения в Vercel → Project Settings → Environment Variables.

# Neon: Project → Connection Details → строка с sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Секрет для подписи сессионных cookie — любая длинная случайная строка, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me"
